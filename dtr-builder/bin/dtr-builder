#!/usr/bin/env sh
# dtr-builder — Automated Extractor (X node)
# Pre-pended execution script for the fat JAR.
# Usage: dtr-builder --out <path> [options]

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
JAR_PATH="$SCRIPT_DIR/../target/scala-2.13/dtr-builder-0.1.1.jar"
MAIN_CLASS="dtrbuilder.control.DtrApp"

if [ ! -f "$JAR_PATH" ]; then
  echo "Error: JAR not found at $JAR_PATH"
  echo "Run 'sbt assembly' first to build the executable JAR."
  exit 1
fi

exec java -jar "$JAR_PATH" "$@"
