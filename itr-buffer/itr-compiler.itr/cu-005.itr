# DTR: TYPE.itr-compiler.control.cli.CliParser, TYPE.itr-compiler.control.dependency_injection.Container, TYPE.itr-compiler.control.entry_point.App, REL.*Container->Repository, REL.*Container->UseCase, REL.*Container->Service, REL.*App->Container, REL.*App->CliParser
# CU-ID: cu-005 SCOPE: CONTROL — CLI flags determine frame structure deterministically
CONTROL.EXISTING_CLI=CliParser
CONTROL.EXISTING_DI=Container
CONTROL.EXISTING_ENTRY=App
CONTROL.EXISTING_FILES=control/cli/CliParser.scala,control/dependency_injection/Container.scala,control/entry_point/App.scala
CONTROL.EXISTING_DEPENDENCIES=Container->Repository,Container->UseCase,Container->Service,App->Container,App->CliParser
# NEW
CONTROL.CLI_FLAGS=--compile,--dtr,--out-folder,--raw-content,--cu-id,--json-content,--yaml-content,--force
CONTROL.CLI_SEMANTICS=single:--raw-content+--cu-id -> one-cu-frame, json:--json-content -> batch-frames, yaml:--yaml-content -> batch-frames
CONTROL.CLI_DETERMINISM=frame-header-derived-from-flags,content-passed-through-unchanged
CONTROL.FRAME_STRUCTURE=header:CU-ID+dtr-path+timestamp+coordinates-if-provided,body:free-form-content
CONTROL.FORCE_BEHAVIOR=without-force:skip-existing-cu,with-force:overwrite-existing-cu
CONTROL.EMPTY_FOLDER_CREATION=mkdir-if-not-exists
CONTROL.NEW_WIRING=Container->DTRLoad,Container->CUWrite,Container->ContentRead,Container->Compile,Container->CoordinateRules,Container->ContentDeserialize,Container->CUStore,Container->FileSystem,Container->JSONFormat,Container->YAMLFormat
