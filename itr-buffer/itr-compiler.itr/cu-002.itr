# DTR: TYPE.itr-compiler.application.ports.Port, TYPE.itr-compiler.application.services.Service, TYPE.itr-compiler.application.use_cases.UseCase, REL.*Service->Port, REL.*UseCase->Port, REL.*UseCase->Service, REL.*Repository->Port, REL.*Environment->Port
# CU-ID: cu-002 SCOPE: APPLICATION ports, input formats, existing service layer
APPLICATION.EXISTING_PORTS=Port
APPLICATION.EXISTING_SERVICES=Service
APPLICATION.EXISTING_USE_CASES=UseCase
APPLICATION.EXISTING_FILES=application/ports/Port.scala,application/services/Service.scala,application/use_cases/UseCase.scala
PORTS.FLOW=Port:IN,OUT
PORTS.IMPLEMENTORS=Repository,Environment
PORTS.CONSUMERS=Service,UseCase
# NEW
APPLICATION.NEW_TRAITS=DTRLoad,CUWrite,ContentRead
APPLICATION.NEW_TRAIT_FILES=application/ports/DTRLoad.scala,application/ports/CUWrite.scala,application/ports/ContentRead.scala
# JSON format: each entry has cu-id, dtr-coordinates (array of strings), content (free-form string)
# YAML format: entry key is cu-id, value has dtr-coordinates list and content string
CONTENT.INPUT_FORMATS=single:--raw-content+--cu-id,batch:--json-content,batch:--yaml-content
CONTENT.JSON_STRUCTURE=[{cu-id,dtr-coordinates:[str],content:str}]
CONTENT.JSONL_STRUCTURE=one-json-object-per-line,same-keys-as-json
CONTENT.YAML_STRUCTURE=cu-id:{dtr-coordinates:[str],content:str}
