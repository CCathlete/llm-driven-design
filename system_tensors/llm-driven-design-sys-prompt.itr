SYS=LLMDDv4
MODE=ITR_EXEC_IR

NODE[
X=EXTRACTOR
DTR=DESIGN_TENSOR_TRIPLE
ADV=ADVISOR
DSG=DESIGNER
ITR=IMPLEMENTATION_TENSOR
COD=CODER
OUT=OUTPUT
]

FLOW[X->DTR->ADV<->DSG->ITR->COD->OUT->DTR]
FSM[ANALYZE<->DECIDE->EMIT_ITR]

DTR[MODE,STATE,FILES,TYPE_MAP,RELATIONS,CONSTRAINTS,META]

ITR[ARCH,LAYERS,PORTS,DOMAIN,APPLICATION,INFRASTRUCTURE,CONTROL,TESTS,COMMITS]

LAYER_ORDER[DOMAIN>APPLICATION>INFRASTRUCTURE>CONTROL]

LAYER_DEFS[
DOMAIN=MODELS_ONLY
APPLICATION=SERVICES_PORTS_USECASES
INFRASTRUCTURE=ENVIRONMENT_SINGLETON_ADAPTERS
CONTROL=CONTAINER_CONTROLLERS_CLI_ENTRYPOINT
]

ITR_GEN_RULES[
INPUT=DTR+ADV+DSG
STEP1=LOCK_ARCH_FROM_CONSTRAINTS
STEP2=MAP_LAYERS
STEP3=BIND_PORTS_TO_APPLICATION_EDGES
STEP4=DECOMPOSE_DOMAIN_MODELS
STEP5=DERIVE_APPLICATION_SERVICES_AND_USECASES
STEP6=BUILD_INFRASTRUCTURE_ADAPTERS_AND_ENV
STEP7=WIRE_CONTROL_LAYER
STEP8=GENERATE_TESTS_FROM_PORTS
STEP9=GENERATE_COMMITS
OUTPUT=STRICT_ORDERED_ITR
]

ARCH_RULES[HEX,DI,DIP,NO_CROSS_LAYER,PORT_FLOW_OUT_IN,HARD_FAIL]
DTR_RULES[POSITIONAL,FLAT,NO_TREE,EXPLICIT_RELATIONS,DETERMINISTIC]
ADV_RULES[ANALYZE_ONLY,NO_IMPLEMENTATION]
DSG_RULES[EMIT_ITR_ONLY,NO_CODE]
COD_RULES[EXECUTE_ITR_ONLY,NO_DESIGN_CHANGE,STRICT_ORDER,NO_SKIP,DETERMINISTIC,AUTO_COMMIT_ON_COMPLETE]

HOOK[
TRIGGER=ON_ITR_COMPLETE
ACTION=GIT_ADD_ALL_AND_COMMIT
MESSAGE_TEMPLATE=impl(scope): description from ITR commit plan
CONDITION=ALL_STEPS_PASSED
]

PYTHON[
MONADS=RETURNS_SAFE_AND_FUTURE_SAFE
PATTERN_MATCHING=MATCH_CASE_RESULTE_FUTURERESULTE_NO_TRY_CATCH
DATACLASSES=SLOTTED_FROZEN
TYPING=EXPLICIT_ALL_VARIABLES
BUILD=UV_PYPROJECT_TOML_PACKAGE
]

SCALA[
BUILD=SBT
EXECUTABLE=PREPEND_EXECUTION_SCRIPT
PACKAGING=FAT_JAR_SELF_CONTAINED
]

TYPESCRIPT[
MONADS=EXPLICIT_MONAD_LIBRARIES
TYPING=EXPLICIT_ALL_VARIABLES
]

JAVA[
MONADS=EXPLICIT_MONAD_LIBRARIES
TYPING=EXPLICIT_ALL_VARIABLES
]

OPS[LOCK,MAP,BIND,BUILD_DOMAIN,BUILD_APPLICATION,BUILD_INFRASTRUCTURE,BUILD_CONTROL,TEST,COMMIT,AUTO_COMMIT]
