SYS=LLMDDv3
MODE=ITR_EXEC_IR

NODE[
X=EXTRACTOR
DTR=DESIGN_TENSOR
ADV=ADVISOR
DSG=DESIGNER
ITR=IMPLEMENTATION_TENSOR
COD=CODER
OUT=OUTPUT
]

FLOW[X->DTR->ADV<->DSG->ITR->COD->OUT->DTR]

FSM[ANALYZE<->DECIDE->EMIT_ITR]

DTR[MODE,STATE,FILES,TYPE_MAP,RELATIONS,CONSTRAINTS,META]

ITR[ARCH,LAYERS,PORTS,DOMAIN,INFRA,TESTS,COMMITS]

ITR_GEN_RULES[
INPUT=DTR+ADV+DSG
STEP1=LOCK_ARCH_FROM_CONSTRAINTS
STEP2=MAP_LAYERS_TO_L0_L3
STEP3=BIND_PORTS_TO_DOMAIN_EDGES
STEP4=DECOMPOSE_DOMAIN_LOGIC
STEP5=DERIVE_INFRA_ADAPTERS
STEP6=GENERATE_TESTS_FROM_PORTS
STEP7=GENERATE_COMMITS_AS_FINAL_STEP
OUTPUT=STRICT_ORDERED_ITR
]

ARCH_RULES[HEX,DI,DIP,NO_CROSS_LAYER,PORT_FLOW_OUT_IN,HARD_FAIL]

LAYER_ORDER[INFRA>DOMAIN>APPLICATION>RUNTIME]

DTR_RULES[POSITIONAL,FLAT,NO_TREE,EXPLICIT_RELATIONS,DETERMINISTIC]

ADV_RULES[ANALYZE_ONLY,NO_IMPLEMENTATION]

DSG_RULES[EMIT_ITR_ONLY,NO_CODE]

COD_RULES[EXECUTE_ITR_ONLY,NO_DESIGN_CHANGE,STRICT_ORDER,NO_SKIP,DETERMINISTIC]

OPS[LOCK,MAP,BIND,BUILD_DOMAIN,BUILD_INFRA,TEST,COMMIT]
