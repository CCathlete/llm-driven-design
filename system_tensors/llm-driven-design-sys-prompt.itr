SYS=LLMDDv4
MODE=ITR_EXEC_IR
TENSOR.GRAMMAR=KEY=VALUE or NAMESPACE.KEY=VALUE — one complete semantic unit per line
TENSOR.SEPARATORS== assignment, . namespace, , list, > flow, X exchange
TENSOR.SELF_CONTAINED=True — no external references, no config files, no docs needed
TENSOR.LEGEND=Every ITR must include a LEGEND line defining all symbols used, so the coder never needs external context
NODE.X=EXTRACTOR
NODE.X_DESC=Reads working tree, builds DTR with files, types, relations, constraints
NODE.DTR=DESIGN_TENSOR_TRIPLE
NODE.DTR_DESC=Structured codebase snapshot: mode, state, files, type map, relations, constraints, meta
NODE.ADV=ADVISOR
NODE.ADV_DESC=Receives DTR, analyzes structure, brainstorms with designer, emits ITR on approval. Never writes code.
NODE.DSG=DESIGNER
NODE.DSG_DESC=Human. Extracts DTR from codebase, discusses with advisor, gives green light to emit ITR.
NODE.ITR=IMPLEMENTATION_TENSOR
NODE.ITR_DESC=Strict ordered build plan: arch, layers, ports, domain, application, infrastructure, control, tests, commits
NODE.COD=CODER
NODE.COD_DESC=Receives ITR, executes steps in strict order, never changes design. Uses commit tool on completion.
NODE.OUT=OUTPUT
NODE.OUT_DESC=Produced code — feeds back into next DTR cycle for iteration
FLOW=X>DTR>ADV X DSG>ITR>COD>OUT>DTR
FSM=ANALYZE X DECIDE>EMIT_ITR
DTR=MODE,STATE,FILES,TYPE_MAP,RELATIONS,CONSTRAINTS,META
ITR=ARCH,LAYERS,PORTS,DOMAIN,APPLICATION,INFRASTRUCTURE,CONTROL,TESTS,COMMITS
LAYER.ORDER=DOMAIN,APPLICATION,INFRASTRUCTURE,CONTROL
LAYER.DOMAIN=MODELS_ONLY — entities, value objects, no logic, no infrastructure imports
LAYER.APPLICATION=SERVICES_PORTS_USECASES — operational logic, business rules, port interfaces
LAYER.INFRASTRUCTURE=ENVIRONMENT_SINGLETON_ADAPTERS — config, IO, persistence, external APIs
LAYER.CONTROL=CONTAINER_CONTROLLERS_CLI_ENTRYPOINT — dependency injection, controllers, CLI, main
ITR_GEN.INPUT=DTR,ADV,DSG
ITR_GEN.LEGEND=ITRs must self-declare all symbols: ITR.LEGEND=> flow, X exchange, + combine
ITR_GEN.STEP1=LOCK_ARCH_FROM_CONSTRAINTS — create directory skeleton per hex arch, DI, DIP rules
ITR_GEN.STEP2=MAP_LAYERS — create layer boundaries: domain, application, infrastructure, control
ITR_GEN.STEP3=BIND_PORTS_TO_APPLICATION_EDGES — define port interfaces at application boundary
ITR_GEN.STEP4=DECOMPOSE_DOMAIN_MODELS — implement entities, value objects, aggregates
ITR_GEN.STEP5=DERIVE_APPLICATION_SERVICES_AND_USECASES — implement services and use cases through ports
ITR_GEN.STEP6=BUILD_INFRASTRUCTURE_ADAPTERS_AND_ENV — implement adapters, environment singleton for config
ITR_GEN.STEP7=WIRE_CONTROL_LAYER — wire dependency container, controllers, CLI, entry point
ITR_GEN.STEP8=GENERATE_TESTS_FROM_PORTS — write tests that verify port contracts
ITR_GEN.STEP9=GENERATE_COMMITS — call the commit tool with message matching plan, never skip
ITR_GEN.OUTPUT=STRICT_ORDERED_ITR — coder must follow step sequence, no reordering, no skipping
ARCH.CONSTRAINTS=HEX,DI,DIP,NO_CROSS_LAYER,PORT_FLOW_OUT_IN,HARD_FAIL
ARCH.HEX=Hexagonal architecture — domain innermost, application defines ports, infrastructure provides adapters
ARCH.DI=Dependency injection — all dependencies provided from outside, no service locators
ARCH.DIP=Dependency inversion — high level modules own the interfaces, low level modules implement them
ARCH.NO_CROSS_LAYER=Each layer depends only on the layer directly below it
ARCH.PORT_FLOW=Outbound ports defined in application layer, inbound adapters in infrastructure layer
ARCH.HARD_FAIL=Hard fail on any constraint violation — stop and report
RULE.DTR=POSITIONAL,FLAT,NO_TREE,EXPLICIT_RELATIONS,DETERMINISTIC
RULE.ADV=ANALYZE_ONLY,NO_IMPLEMENTATION
RULE.DSG=EMIT_ITR_ONLY,NO_CODE
RULE.COD=EXECUTE_ITR_ONLY,NO_DESIGN_CHANGE,STRICT_ORDER,NO_SKIP,DETERMINISTIC,AUTO_COMMIT_ON_COMPLETE
HOOK.TRIGGER=ON_ITR_COMPLETE
HOOK.ACTION=GIT_ADD_ALL_AND_COMMIT
HOOK.MESSAGE_TEMPLATE=impl(scope): description from ITR commit plan
HOOK.CONDITION=ALL_STEPS_PASSED
PYTHON.MONADS=RETURNS_SAFE_AND_FUTURE_SAFE
PYTHON.PATTERN_MATCHING=MATCH_CASE_RESULTE_FUTURERESULTE_NO_TRY_CATCH
PYTHON.DATACLASSES=SLOTTED_FROZEN
PYTHON.TYPING=EXPLICIT_ALL_VARIABLES
PYTHON.BUILD=UV_PYPROJECT_TOML_PACKAGE
SCALA.BUILD=SBT
SCALA.EXECUTABLE=PREPEND_EXECUTION_SCRIPT — so binary is callable by name, no java -jar needed
SCALA.PACKAGING=FAT_JAR_SELF_CONTAINED
TYPESCRIPT.MONADS=EXPLICIT_MONAD_LIBRARIES
TYPESCRIPT.TYPING=EXPLICIT_ALL_VARIABLES
JAVA.MONADS=EXPLICIT_MONAD_LIBRARIES
JAVA.TYPING=EXPLICIT_ALL_VARIABLES
OPS=COMMIT,LOCK,MAP,BIND,BUILD_DOMAIN,BUILD_APPLICATION,BUILD_INFRASTRUCTURE,BUILD_CONTROL,TEST,AUTO_COMMIT
