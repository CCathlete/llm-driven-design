*.class
*.tasty
*.log

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

**/.metals
**/.bloop
**/.bsp
**/target

**/__pycache__

**/*.env.*
**/*.env

**/output
**/input

# Assembled fat JARs — published as GitHub Releases, not tracked in git.
# Build with: cs launch sbt -- assembly   (then copy the binary to the module root)
# Anchored to module roots so nested paths are unaffected.
/dtr-builder/dtr-builder
/commit-tool/commit-tool
/itr-compiler/itr-compiler

CU_*_IMPLEMENTATION_STEPS*.itr
**/IMPLEMENTATION_STEPS.itr

# Wave-runner execution outputs: runtime-only per-run state, never tracked.
# (Feedback is consumed during the run; the committed record is the code.)
.LLMDD/ITRS/*.convergence.json
.LLMDD/ITRS/*.logs/
.LLMDD/ITRS/*.feedback/
*.convergence.json
*.logs/
*.feedback/
/.LLMDD/tools/*
!/.LLMDD/tools/run-waves.py
!/.LLMDD/tools/test_synopsis_budget.py
!/.LLMDD/tools/validate-steps.py
!/.LLMDD/tools/*README.md
