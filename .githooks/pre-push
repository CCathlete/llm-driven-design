#!/bin/sh

# Pre-push hook: block pushes from AI coding assistants.
# Only the user (interactive terminal) should push to remote.
#
# Detection method: walk the parent process tree looking for
# known AI coding-assistant binaries. This is the only reliable
# approach -- AI assistants rarely set unique env vars, and even
# when they do, the var name is an implementation detail that
# can change without notice.

set -e

AGENT_DETECTED=0

# ---------------------------------------------------------------------------
# Walk parent process tree for known agent tool binaries
# ---------------------------------------------------------------------------
if command -v ps >/dev/null 2>&1; then
  AGENT_TOOLS="opencode copilot claude-code cursor windsurf aider"
  PPID=$$
  while [ "$PPID" -ne 1 ] && [ "$PPID" -ne 0 ]; do
    PPID=$(ps -o ppid= -p "$PPID" 2>/dev/null | tr -d ' ')
    [ -z "$PPID" ] && break
    CMD=$(ps -o comm= -p "$PPID" 2>/dev/null | tr -d ' ')
    ARGS=$(ps -o args= -p "$PPID" 2>/dev/null | head -c 120)
    for TOOL in $AGENT_TOOLS; do
      case "$CMD" in
        *"$TOOL"*)
          echo "ERROR: Agent tool '$TOOL' detected in process tree (PID=$PPID)." >&2
          AGENT_DETECTED=1
          ;;
      esac
      case "$ARGS" in
        *"$TOOL"*)
          echo "ERROR: Agent tool '$TOOL' detected in process tree args (PID=$PPID)." >&2
          AGENT_DETECTED=1
          ;;
      esac
    done
  done
fi

# ---------------------------------------------------------------------------
# Block if agent detected
# ---------------------------------------------------------------------------
if [ "$AGENT_DETECTED" -ne 0 ]; then
  echo "" >&2
  echo "Push rejected: AI coding assistants are not allowed to push to remote." >&2
  echo "Only the repository owner may push from an interactive terminal." >&2
  exit 1
fi

exit 0
